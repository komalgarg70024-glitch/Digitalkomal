# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PAGESPEED_API_KEY: Optional API key for Google PageSpeed Insights v5 API higher quota.
PAGESPEED_API_KEY=""

# Optional Authorized Integrations (Google Search Console, GA4, Keyword & Backlink Providers)
GSC_ACCESS_TOKEN=""
GA4_ACCESS_TOKEN=""
KEYWORD_PROVIDER_API_KEY=""
BACKLINK_PROVIDER_API_KEY=""
